<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_icon_circle_primary">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🔑"
            android:textSize="28sp" />
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/sifremi_unuttum_baslik"
        android:textColor="@color/primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Güvenlik anahtarınız cihazınıza göre otomatik doldurulur. Sadece kayıt olduğunuz cihazdan şifre sıfırlayabilirsiniz."
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="4dp"
        android:text="@string/kullanici_adi"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etKullaniciAdi"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_field"
        android:hint="@string/kullanici_adi_hint"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/outline"
        android:textSize="14sp" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:text="Güvenlik Anahtarı"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etGuvenlikAnahtari"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_field"
        android:hint="Otomatik doldurulacak"
        android:inputType="text"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/outline"
        android:textSize="14sp" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:text="@string/yeni_sifre"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etYeniSifre"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_field"
        android:hint="@string/guclu_sifre"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/outline"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSifreGuncelle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/primary"
        android:text="@string/sifre_guncelle"
        android:textAllCaps="false"
        android:textColor="@color/on_primary"
        android:textSize="14sp"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGeri"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/geri"
        android:textAllCaps="false"
        android:textColor="@color/on_surface_variant" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />
</LinearLayout>
