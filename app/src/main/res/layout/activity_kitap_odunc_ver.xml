<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/surface"
        android:elevation="2dp" android:gravity="center_vertical" android:paddingHorizontal="8dp">
        <ImageButton android:id="@+id/btnGeri" android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_revert" app:tint="@color/primary" android:contentDescription="@string/geri"/>
        <com.google.android.material.textview.MaterialTextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="@string/kitap_odunc_ver" android:textColor="@color/primary"
            android:textSize="18sp" android:textStyle="bold" android:fontFamily="serif"/>
        <View android:layout_width="40dp" android:layout_height="40dp"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <com.google.android.material.textview.MaterialTextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/uye_sec" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:textStyle="bold"
                android:layout_marginBottom="6dp" android:layout_marginStart="4dp"/>
            <Spinner android:id="@+id/spinnerUye" android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_input_field" android:paddingHorizontal="16dp"/>

            <com.google.android.material.textview.MaterialTextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/kitap_sec" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:textStyle="bold"
                android:layout_marginBottom="6dp" android:layout_marginStart="4dp" android:layout_marginTop="16dp"/>
            <Spinner android:id="@+id/spinnerKitap" android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_input_field" android:paddingHorizontal="16dp"/>

            <com.google.android.material.textview.MaterialTextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/teslim_tarihi" android:textColor="@color/on_surface_variant" android:textSize="12sp" android:textStyle="bold"
                android:layout_marginBottom="6dp" android:layout_marginStart="4dp" android:layout_marginTop="16dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTarihSec" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="48dp" android:text="Tarih Seçiniz" android:textAllCaps="false"
                android:textColor="@color/on_surface" app:cornerRadius="12dp" app:strokeColor="@color/outline_variant"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnOduncVer" android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="32dp" android:backgroundTint="@color/primary" android:text="@string/odunc_ver" android:textAllCaps="false"
                android:textColor="@color/on_primary" android:textSize="14sp" app:cornerRadius="12dp"/>

            <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:layout_marginTop="16dp" android:visibility="gone" android:indeterminateTint="@color/primary"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
